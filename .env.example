DATABASE_URL=postgres://postgres:dev@127.0.0.1:5433/dios-cloud-web
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=preview-secret

# RustFS (S3-compatible). Set S3_ENABLED=false to keep uploads on local disk.
S3_ENABLED=true
S3_BUCKET=dios-media
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# Seed safety. Production seed is blocked unless this is true.
ALLOW_PRODUCTION_SEED=false
